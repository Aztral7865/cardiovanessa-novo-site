---
import Atuacao from "../components/Atuacao.astro";
import BrandIcon from "../components/BrandIcon.astro";
import Closing from "../components/Closing.astro";
import Contato from "../components/Contato.astro";
import Depoimentos from "../components/Depoimentos.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Mitos from "../components/Mitos.astro";
import Perguntas from "../components/Perguntas.astro";
import Sobre from "../components/Sobre.astro";
import Trajetoria from "../components/Trajetoria.astro";
import { bookingLink } from "../data/site";
import Base from "../layouts/Base.astro";
---

<Base>
  <Header />
  <main id="conteudo" tabindex="-1">
    <Hero />
    <Sobre />
    <Trajetoria />
    <Atuacao />
    <Depoimentos />
    <Mitos />
    <Perguntas />
    <Contato />
  </main>
  <Closing />
  <nav class="actionbar" aria-label="Agendamento" data-actionbar>
    <a class="btn btn--block" href={bookingLink} target="_blank" rel="noopener" data-cta="bar">
      <BrandIcon name="whatsapp" size={20} />
      Agendar consulta
    </a>
  </nav>
  <script>
    import "../scripts/site.ts";
  </script>
</Base>
