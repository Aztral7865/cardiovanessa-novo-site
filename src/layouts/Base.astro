---
import { Font } from "astro:assets";
import { contact, site } from "../data/site";
import "../styles/global.css";

const PREVIEW = import.meta.env.PUBLIC_PREVIEW === true;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path}`;
const canonical = new URL(base, Astro.site).href;
const shareImage = new URL(asset("share.jpg"), Astro.site).href;
const title = `${site.name} | Cardiologista em Criciúma`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Physician",
  name: site.name,
  description: site.description,
  medicalSpecialty: "Cardiovascular",
  url: canonical,
  image: shareImage,
  telephone: contact.phoneDisplay,
  email: contact.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: `${contact.address.street}, ${contact.address.rooms}`,
    addressLocality: contact.address.city,
    addressRegion: contact.address.state,
    addressCountry: "BR",
  },
  hasMap: contact.address.maps,
  identifier: [
    { "@type": "PropertyValue", propertyID: "CRM/SC", value: "20674" },
    { "@type": "PropertyValue", propertyID: "RQE", value: "15969" },
    { "@type": "PropertyValue", propertyID: "RQE", value: "17474" },
  ],
  sameAs: [contact.instagram],
};
---

<!doctype html>
<html lang="pt-BR" data-type="service">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    {PREVIEW ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="site-kind" content="other" />
    <meta name="page-type" content="service" />
    <meta name="theme-color" content="#FDFCFC" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dra. Vanessa Damin, cardiologista em Criciúma" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={asset("favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} />
    <link rel="manifest" href={asset("site.webmanifest")} />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-condensed" preload />

    <script is:inline>
      document.documentElement.classList.add("m-enter");
      setTimeout(() => document.documentElement.classList.add("m-enter-done"), 2200);
    </script>
    <script is:inline>
      document.documentElement.classList.add("mo-js");
      setTimeout(() => document.documentElement.classList.add("mo-safe"), 2500);
    </script>
    <link rel="modulepreload" href={asset("assets/moments/moments.js")} />
    <link rel="modulepreload" href={asset("assets/moments/lib.js")} />
    <link rel="modulepreload" href={asset("assets/moments/picture-develops/moment.js")} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <script type="module" src={asset("assets/moments/moments.js")}></script>
  </body>
</html>
