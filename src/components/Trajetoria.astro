---
import { Image } from "astro:assets";
import formacaoFoto from "../assets/photos/vanessa-bracos-cruzados.jpg";
import plantaoFoto from "../assets/photos/vanessa-jaleco.jpg";
import docenciaFoto from "../assets/photos/vanessa-e-fernando.jpg";
import { experiencia, formacao } from "../data/trajetoria";

const [medicina, clinica, cardio, cursos] = formacao;
const [plantao, ufsc, samu, uti] = experiencia;

const capitulos = [
  {
    title: "Formação",
    items: [medicina, clinica, cardio, cursos],
    img: formacaoFoto,
    alt: "Dra. Vanessa Damin de jaleco, braços cruzados, sorrindo",
    pos: "50% 16%",
  },
  {
    title: "Plantão e emergência",
    items: [plantao, samu, uti],
    img: plantaoFoto,
    alt: "Dra. Vanessa Damin de jaleco, com as mãos nos bolsos",
    pos: "50% 12%",
  },
  {
    title: "Docência",
    items: [ufsc],
    img: docenciaFoto,
    alt: "Dra. Vanessa Damin e Dr. Fernando, de jaleco",
    pos: "50% 10%",
  },
];
---

<section class="trajetoria paper-grid" id="trajetoria" data-moment="photo-chapters" aria-labelledby="traj-h">
  <div class="wrap mo-ph">
    <div class="mo-ph__head">
      <h2 id="traj-h">Formação e experiência da cardiologista</h2>
      <p>Residências em Clínica Médica e Cardiologia, anos de urgência e emergência e docência na UFSC.</p>
    </div>
    <ol class="mo-ph__list">
      {
        capitulos.map((c) => (
          <li class="mo-ph__ch">
            <figure class="mo-ph__pic">
              <Image
                src={c.img}
                format="webp"
                widths={[480, 800, 1200, 1600]}
                sizes="(min-width: 1440px) 1280px, 100vw"
                alt={c.alt}
                loading="lazy"
                style={`object-position: ${c.pos}`}
              />
            </figure>
            <h3>{c.title}</h3>
            <ul class="traj-items">
              {c.items.map((m) => (
                <li>
                  <span class="traj-items__period num">{m.period}</span>
                  <span class="traj-items__title">
                    {m.title}{m.place && <span class="traj-items__place"> · {m.place}</span>}{m.note && <span class="traj-items__place">, {m.note}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
