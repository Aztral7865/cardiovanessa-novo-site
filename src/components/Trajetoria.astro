---
import { Image } from "astro:assets";
import formacaoFoto from "../assets/photos/vanessa-formacao.jpg";
import plantaoFoto from "../assets/photos/vanessa-plantao.jpg";
import docenciaFoto from "../assets/photos/vanessa-docencia.jpg";
import { experiencia, formacao } from "../data/trajetoria";

const [medicina, clinica, cardio, cursos] = formacao;
const [plantao, ufsc, samu, uti] = experiencia;

// três capítulos fixos, cada um com a sua foto e a sua lista de laudo
const capitulos = [
  {
    title: "Formação",
    items: [medicina, clinica, cardio, cursos],
    img: formacaoFoto,
    alt: "Dra. Vanessa Damin de conjunto claro, sorrindo, com a mão apoiada no queixo",
    pos: "50% 8%",
  },
  {
    title: "Plantão e emergência",
    items: [plantao, samu, uti],
    img: plantaoFoto,
    alt: "Dra. Vanessa Damin de conjunto claro, com um braço cruzado e a mão junto à gola",
    pos: "50% 6%",
  },
  {
    title: "Docência",
    items: [ufsc],
    img: docenciaFoto,
    alt: "Dra. Vanessa Damin apoiada no encosto de uma cadeira, sorrindo",
    pos: "50% 2%",
  },
];
---

<section class="trajetoria paper-grid" id="trajetoria" aria-labelledby="traj-h">
  <div class="wrap traj">
    <div class="section-head traj__head">
      <h2 id="traj-h">Formação e experiência da cardiologista</h2>
      <p>Residências em Clínica Médica e Cardiologia, anos de urgência e emergência e docência na UFSC.</p>
    </div>
    <ol class="traj__list">
      {
        capitulos.map((c) => (
          <li class="chapter">
            <figure class="chapter__pic">
              <Image
                src={c.img}
                format="webp"
                widths={[360, 560, 720, 1000]}
                sizes="(min-width: 1280px) 310px, (min-width: 1024px) 30vw, (min-width: 640px) 38vw, calc(100vw - 48px)"
                alt={c.alt}
                loading="lazy"
                style={`object-position: ${c.pos}`}
              />
            </figure>
            <div class="chapter__body">
              <h3>{c.title}</h3>
              <ul class="traj-items">
                {c.items.map((m) => (
                  <li>
                    <span class="traj-items__period num">{m.period}</span>
                    <span class="traj-items__title">
                      {m.title}{m.place && <span class="traj-items__place"> · {m.place}</span>}{m.note && <span class="traj-items__place">, {m.note}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
